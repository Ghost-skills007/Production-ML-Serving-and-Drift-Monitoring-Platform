# Copy to .env and adjust values. Never commit .env itself.

# --- Model store ---
# local | s3
MODEL_STORE=local
MODEL_DIR=models
# Bucket must be private, versioned and encrypted (see infra/deploy_ec2.md)
S3_BUCKET=ml-serving-drift-platform-models
S3_PREFIX=models
# "latest" picks the newest version; pin a UTC timestamp like 20261101T093000Z to roll back
MODEL_VERSION=latest
AWS_REGION=us-east-1

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mlmonitor
POSTGRES_USER=mluser
POSTGRES_PASSWORD=changeme
# If set, this full DSN wins over the individual POSTGRES_* settings.
# DATABASE_URL=postgresql+psycopg2://mluser:changeme@localhost:5432/mlmonitor
# Set to "0" to disable prediction logging entirely (useful for quick local trials).
DB_ENABLED=1

# --- Drift ---
PSI_THRESHOLD=0.2
KS_ALPHA=0.05
DRIFT_FEATURE_FRACTION=0.2
DRIFT_BIN_COUNT=10
DRIFT_EPSILON=1e-6

# --- Docker Compose ---
# Used by docker-compose.yml for the exposed port and postgres container
COMPOSE_API_PORT=8000
POSTGRES_PASSWORD_COMPOSE=changeme
